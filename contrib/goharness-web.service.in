# goharness web UI as a systemd user service. Generated by `make install-service`;
# edit the Makefile variables and re-run it rather than editing the installed copy.
[Unit]
Description=goharness web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@PROJECT@
ExecStart=@BIN@ web --addr @ADDR@ --projects-root @PROJECTS_ROOT@ @WEB_FLAGS@
# The agent's shell commands need the tools on your normal PATH (go, npm, conda, ...).
Environment=PATH=@PATH@
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
