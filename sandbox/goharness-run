#!/bin/bash
# goharness-run [--profile NAME] [--web [PORT]] [--open-net] [--exec 'cmd'] <project-dir>
#   (default)        open the goharness terminal UI inside the sandbox
#   --web [PORT]     run the web UI in the background instead (default port 8790; normal networking)
#   --profile NAME   load ~/goharness-container/profiles/NAME.conf (default: default)
#   --open-net       ignore the profile's NETWORK and use normal Docker networking
#   --publish H:C    publish container port C on host port H (repeatable; implies normal networking)
#   --exec 'cmd'     run one shell command in the sandbox instead of goharness (for checks)
set -e
H=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)   # the folder this script lives in, wherever it was copied
PROFILE=default; WEB=0; PORT=8790; EXEC=""; OPEN=0; PUB=()
while [ $# -gt 0 ]; do case "$1" in
  --profile) PROFILE=$2; shift 2;;
  --web) WEB=1; shift; if [[ "${1:-}" =~ ^[0-9]+$ ]]; then PORT=$1; shift; fi;;
  --open-net) OPEN=1; shift;;
  --publish) PUB+=(-p "$2"); OPEN=1; shift 2;;
  --exec) EXEC=$2; shift 2;;
  -h|--help) sed -n 2,8p "$0"; exit 0;;
  *) break;; esac; done
[ -n "$1" ] || { sed -n 2,8p "$0"; exit 1; }
P=$(realpath "$1")
BASE_URL=${GOHARNESS_BASE_URL:-http://172.16.10.46:40115/v1}; MODEL=qwen36_35B_reap48_v2; CONTEXT=49152; ROUNDS=30; SUBAGENT_MODEL=gemma4_12B_qat; PARALLEL=2; NETWORK=olla-only; MEMORY=4g
SKILLS_DIR=; PERMISSIONS_FILE=; RULES_FILES=
[ -f "$H/profiles/$PROFILE.conf" ] || { echo "no profile $H/profiles/$PROFILE.conf"; exit 1; }
. "$H/profiles/$PROFILE.conf"
[ -n "$GOHARNESS_MODEL" ] && MODEL=$GOHARNESS_MODEL
[ -n "$GOHARNESS_BASE_URL" ] && BASE_URL=$GOHARNESS_BASE_URL   # environment beats the profile
N=gh-$(basename "$P"); S=$H/state/$N; mkdir -p "$S/.goharness/skills" "$S/.config/goharness"

# the agent talks to BASE_URL directly, or (olla-only) through a relay container that is the only thing on its network
BASE=$BASE_URL; NETARGS=()
if [ "$NETWORK" = "olla-only" ] && [ $OPEN = 0 ] && [ $WEB = 0 ]; then
  UP=$(echo "$BASE_URL" | sed -E 's#^https?://([^/]+).*#\1#'); case "$UP" in *:*) ;; *) UP=$UP:80;; esac
  UPPORT=${UP##*:}
  docker network inspect gh-net >/dev/null 2>&1 || docker network create --internal gh-net >/dev/null
  docker image inspect gh-proxy:dev >/dev/null 2>&1 || docker build -q -t gh-proxy:dev -f "$H/Dockerfile.proxy" "$H" >/dev/null
  docker rm -f gh-olla-proxy >/dev/null 2>&1 || true   # name used by the first prototype
  if [ "$(docker inspect -f '{{index .Config.Labels "gh.target"}}' gh-relay 2>/dev/null)" != "$UP" ]; then
    docker rm -f gh-relay >/dev/null 2>&1 || true
    docker run -d --name gh-relay --label gh.target="$UP" --restart unless-stopped gh-proxy:dev TCP-LISTEN:"$UPPORT",fork,reuseaddr TCP:"$UP" >/dev/null
    docker network connect gh-net gh-relay
  fi
  BASE=http://gh-relay:$UPPORT$(echo "$BASE_URL" | sed -E 's#^https?://[^/]+##'); NETARGS=(--network gh-net)
fi

MOUNTS=(-v "$P":/work -v "$S":/home/agent)
# links in the project that point outside it (a node_modules link, say) are mounted read-only at the same path so they resolve
while IFS= read -r l; do t=$(realpath "$l" 2>/dev/null || true); case "$t" in "$P"/*|"") ;; *) [ -e "$t" ] && MOUNTS+=(-v "$t:$t:ro");; esac; done < <(find "$P" -maxdepth 1 -type l)
if [ -n "$SKILLS_DIR" ]; then mkdir -p "$S/.goharness/skills/shared"; MOUNTS+=(-v "$SKILLS_DIR":/home/agent/.goharness/skills/shared:ro); fi
[ -n "$PERMISSIONS_FILE" ] && cp "$PERMISSIONS_FILE" "$S/.config/goharness/permissions.json"
rm -rf "$S/.goharness/skills/project-rules"
if [ -n "$RULES_FILES" ]; then
  mkdir -p "$S/.goharness/skills/project-rules"; R="$S/.goharness/skills/project-rules/SKILL.md"
  printf -- '---\nname: project-rules\ndescription: The rules and current state of this project. Load this FIRST at the start of every task and follow it.\n---\n\n' > "$R"
  for f in $RULES_FILES; do [ -f "$f" ] || f="$P/$f"; [ -f "$f" ] && { printf '## %s\n\n' "$(basename "$f")" >> "$R"; cat "$f" >> "$R"; printf '\n\n' >> "$R"; }; done
fi

COMMON=(--user "$(id -u):$(id -g)" "${MOUNTS[@]}" --cap-drop ALL --security-opt no-new-privileges --memory "$MEMORY"
        -e GOHARNESS_SUBAGENT_MODEL="$SUBAGENT_MODEL" -e GOHARNESS_PARALLEL="$PARALLEL" -e GH_BASE_URL="$BASE")
GH=(-base-url "$BASE" -model "$MODEL" -context-tokens "$CONTEXT" -max-rounds "$ROUNDS")
if [ -n "$EXEC" ]; then
  exec docker run --rm -i "${NETARGS[@]}" "${PUB[@]}" "${COMMON[@]}" --entrypoint bash goharness-sandbox:dev -c "$EXEC"
elif [ $WEB = 1 ]; then
  docker rm -f "$N" >/dev/null 2>&1 || true
  docker run -d --name "$N" --restart unless-stopped "${COMMON[@]}" -p "$PORT":8790 goharness-sandbox:dev web --addr 0.0.0.0:8790 \
    "${GH[@]}" --projects-root /work --allow-any-dir >/dev/null
  echo "web UI started: $N on port $PORT (restarts on boot). Login link: docker logs $N 2>&1 | grep -o 'http://[^ ]*token=[^ ]*' | head -1"
else
  exec docker run -it --rm -e TERM="${TERM:-xterm-256color}" "${NETARGS[@]}" "${PUB[@]}" "${COMMON[@]}" goharness-sandbox:dev "${GH[@]}"
fi
